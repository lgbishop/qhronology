Matrix([
[   cos(θ/2),           0,           0, -I*sin(θ/2)],
[          0,    cos(θ/2), -I*sin(θ/2),           0],
[          0, -I*sin(θ/2),    cos(θ/2),           0],
[-I*sin(θ/2),           0,           0,    cos(θ/2)]])
R_xx(θ) = (exp(I*θ)/2 + 1/2)*exp(-I*θ/2)|0,0⟩⟨0,0| + (1/2 - exp(I*θ)/2)*exp(-I*θ/2)|0,0⟩⟨1,1| + (exp(I*θ)/2 + 1/2)*exp(-I*θ/2)|0,1⟩⟨0,1| + (1/2 - exp(I*θ)/2)*exp(-I*θ/2)|0,1⟩⟨1,0| + (1/2 - exp(I*θ)/2)*exp(-I*θ/2)|1,0⟩⟨0,1| + (exp(I*θ)/2 + 1/2)*exp(-I*θ/2)|1,0⟩⟨1,0| + (1/2 - exp(I*θ)/2)*exp(-I*θ/2)|1,1⟩⟨0,0| + (exp(I*θ)/2 + 1/2)*exp(-I*θ/2)|1,1⟩⟨1,1|
