  url = {https://iopscience.iop.org/article/10.1088/0264-9381/9/10/014},
  abstract = {A new type of self-consistent evolution in the spacetime with a time machine is discussed. The authors propose the hypothesis of the possible existence of systems with closed world-lines (the Jinn of the time machine). These systems are possible only if they can, by interacting with external objects, gain energy to regenerate their internal structure. The consequences of the hypothesis are discussed.}
