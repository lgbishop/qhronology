  url = {https://link.aps.org/doi/10.1103/PhysRevLett.80.2980},
  abstract = {In this paper we find a self-consistent vacuum for Misner space. For this ``adapted'' Rindler vacuum the renormalized stress-energy tensor is zero throughout the Misner space (except on the Cauchy horizon itself, a set of measure zero on which it remains formally ill-defined). A pointlike particle detector traveling on a timelike geodesic in a Misner space with this vacuum detects nothing, but a time traveler may pose a danger to himself and to the space-time.}
