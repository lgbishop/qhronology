@article{lossev_jinn_1992,
  title = {The Jinn of the Time Machine: Nontrivial Self-Consistent Solutions},
  shorttitle = {The Jinn of the Time Machine},
  author = {Lossev, Andrei S. and Novikov, Igor D.},
  year = 1992,
  journal = {Classical and Quantum Gravity},
