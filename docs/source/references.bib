  author = {D'Ariano, Giacomo Mauro and Paris, Matteo G.A. and Sacchi, Massimiliano F.},
  editor = {Paris, Matteo and {\v R}eh{\'a}{\v c}ek, Jaroslav},
  year = 2004,
  series = {Lecture {{Notes}} in {{Physics}}},
  pages = {7--58},
  publisher = {Springer},
