@article{aharonov_how_1988,
  title = {How the Result of a Measurement of a Component of the Spin of a Spin-1/2 Particle Can Turn out to Be 100},
  author = {Aharonov, Yakir and Albert, David Z. and Vaidman, Lev},
  year = 1988,
  month = apr,
  journal = {Physical Review Letters},
  volume = {60},
  number = {14},
  pages = {1351--1354},
  publisher = {American Physical Society},
  doi = {10.1103/PhysRevLett.60.1351},
  url = {https://link.aps.org/doi/10.1103/PhysRevLett.60.1351},
  abstract = {We have found that the usual measuring procedure for preselected and postselected ensembles of quantum systems gives unusual results. Under some natural conditions of weakness of the measurement, its result consistently defines a new kind of value for a quantum variable, which we call the weak value. A description of the measurement of the weak value of a component of a spin for an ensemble of preselected and postselected spin-(1/2 particles is presented.}
}

@article{aharonov_properties_1990,
  title = {Properties of a Quantum System during the Time Interval between Two Measurements},
  author = {Aharonov, Yakir and Vaidman, Lev},
  year = 1990,
  month = jan,
  journal = {Physical Review A},
  volume = {41},
  number = {1},
  pages = {11--20},
  publisher = {American Physical Society},
  doi = {10.1103/PhysRevA.41.11},
  url = {https://link.aps.org/doi/10.1103/PhysRevA.41.11},
  abstract = {A description of quantum systems at the time interval between two successive measurements is presented. Two wave functions, the first preselected by the initial measurement and the second postselected by the final measurement, describe quantum systems at a single time. It is shown how this approach leads to a new concept: a weak value of an observable. Weak values represent novel characteristics of quantum systems between two measurements. They are outcomes of a standard measurement procedure that fulfills certain requirements of ``weakness.'' We call it weak measurement. Physical meaning, underlying mathematical structure, and prospects of practical usage of weak measurements are explored.}
}

