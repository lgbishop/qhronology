  month = sep,
  journal = {Quantum Studies: Mathematics and Foundations},
  volume = {5},
  number = {3},
  pages = {423--437},
  issn = {2196-5617},
  doi = {10.1007/s40509-018-0155-0},
  url = {https://doi.org/10.1007/s40509-018-0155-0},
  abstract = {As shown in Aharonov (Phys Rev A 72(5):052111, 2005), in an arbitrary-strength quantum measurement performed on a pre- and post-selected system, the quantum state that describes the conditional response of the apparatus can be decomposed as a superposition of states, each of which encodes a weak measurement of the measured observable. In this paper, we introduced a new scheme of weak value tomography, which allows one to image the weak measurement components underlying the spectral distributions of a strong measurement. We also show how coarse-grained features of the strong spectral distributions can be connected to features that can be extracted from the weak value tomography of a strong measurement.},
  keywords = {Post-selection,Quantum measurement,Weak measurements,Weak values}
}

